# Copy to .env at the repository root. Do not wrap values in quotes.
# Use the connection details shown in Aiven Console.
DB_HOST=your-service.aivencloud.com
DB_PORT=your-aiven-port
DB_NAME=defaultdb
DB_USERNAME=avnadmin
DB_PASSWORD=your-aiven-password
DB_TRUSTSTORE_URL=file:/absolute/path/to/RE-mind/backend/certs/aiven-truststore.p12
DB_TRUSTSTORE_PASSWORD=your-truststore-password

# Local AI MVP: default demo makes no external calls.
# Switch only when API account requirements are met; use fictional data.
ONI_AI_PROVIDER=demo
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
