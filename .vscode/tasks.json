{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "온이: 백엔드 실행",
      "type": "shell",
      "command": "./gradlew",
      "windows": {"command": ".\\gradlew.bat"},
      "args": ["bootRun", "--args=--spring.profiles.active=oni"],
      "options": {
        "cwd": "${workspaceFolder}/backend",
        "env": {"GRADLE_USER_HOME": "${workspaceFolder}/.local-gradle"}
      },
      "problemMatcher": [],
      "presentation": {"reveal": "always", "panel": "dedicated"}
    },
    {
      "label": "온이: 프런트 의존성 설치",
      "type": "shell",
      "command": "npm",
      "args": ["ci"],
      "options": {"cwd": "${workspaceFolder}/frontend"},
      "problemMatcher": []
    },
    {
      "label": "온이: 프런트 실행",
      "type": "shell",
      "command": "npm",
      "args": ["run", "dev"],
      "options": {"cwd": "${workspaceFolder}/frontend"},
      "problemMatcher": [],
      "presentation": {"reveal": "always", "panel": "dedicated"}
    },
    {
      "label": "온이: 백엔드 테스트",
      "type": "shell",
      "command": "./gradlew",
      "windows": {"command": ".\\gradlew.bat"},
      "args": ["test"],
      "options": {
        "cwd": "${workspaceFolder}/backend",
        "env": {"GRADLE_USER_HOME": "${workspaceFolder}/.local-gradle"}
      },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "온이: 프런트 빌드",
      "type": "shell",
      "command": "npm",
      "args": ["run", "build"],
      "options": {"cwd": "${workspaceFolder}/frontend"},
      "group": "build",
      "problemMatcher": []
    }
  ]
}
