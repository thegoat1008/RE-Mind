# Copy this example to backend/.env.rag. Enter real keys only in that ignored local file.
# Run commands from backend so that ./.env.rag is imported.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
PUBLIC_DATA_SERVICE_KEY=

# Exact browser origins only. No wildcard; no path after the port.
RAG_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080

# For rag,rag-mysql: enter the reachable DB server hostname, not a teammate's 127.0.0.1.
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USERNAME=
DB_PASSWORD=

# Existing dev/prod profiles additionally require the team's Aiven truststore settings.
# Schema initialization for shared DB is opt-in; review rag/schema.sql first.
# The shared-DB default is false. Use --rag.schema.initialize=true explicitly only for initial setup.
